# Copy this file to .env.local and fill in your values
# .env.local is gitignored — your credentials stay local

# Set to "true" to use mock data (no Supabase needed)
# Set to "false" to use real Supabase database
VITE_USE_MOCK=true

# Supabase credentials (only needed when VITE_USE_MOCK=false)
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
